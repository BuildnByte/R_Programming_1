pics <- c('P1.jpeg','P2.jpeg','P3.jpeg','P4.jpeg','P5.jpeg','P6.jpeg','C1.jpeg','C2.jpeg','C3.jpeg','C4.jpeg','C5.jpeg','C6.jpeg')
